{
	chapter.09197870389BB01C.chapter_subtitle: [
		"Перші шестерні, перший млин, перший крок до Інтерсіті."
	]
	chapter.09197870389BB01C.title: "Андезитова доба"
	chapter.0C9CE36ABBEE23D0.chapter_subtitle: [
		"Дрон англійською — «трутень». Тож тепер ти пасічник."
	]
	chapter.0C9CE36ABBEE23D0.title: "Пасіка"
	chapter.0CC94473CE0FCADD.chapter_subtitle: [
		"Від Карпат до Чорного моря. Дорогою — печери, руїни і трохи пригод."
	]
	chapter.0CC94473CE0FCADD.title: "Мандри Україною"
	chapter.26D8EC259B627E3A.chapter_subtitle: [
		"Create Aeronautics. Повітряний простір закритий для всіх, крім тебе."
	]
	chapter.26D8EC259B627E3A.title: "Небо"
	chapter.2A42D404A1DC4559.chapter_subtitle: [
		"Від Карпат до Хортиці. Кожен регіон — своя страва."
	]
	chapter.2A42D404A1DC4559.title: "Смачна мапа України"
	chapter.314E36BDE903881A.chapter_subtitle: [
		"Склад, сортування і доставка за один день."
	]
	chapter.314E36BDE903881A.title: "Нова Пошта"
	chapter.372391D7030961DD.chapter_subtitle: [
		"Генератора ще нема, зате є руки."
	]
	chapter.372391D7030961DD.title: "Перший день"
	chapter.4A5A995A81894D15.chapter_subtitle: [
		"Скоро зима. Графік відключень тепер пишеш ти."
	]
	chapter.4A5A995A81894D15.title: "Свій ДТЕК"
	chapter.4CCF33DC7A12A6F0.chapter_subtitle: [
		"Запізнення не передбачені, але чай у підстаканнику про всяк випадок є."
	]
	chapter.4CCF33DC7A12A6F0.title: "Укрзалізниця вдома"
	chapter.53FB2386C9C6AEB9.chapter_subtitle: [
		"Дідова скриня в гаражі відчинилась."
	]
	chapter.53FB2386C9C6AEB9.title: "Січ"
	chapter.5E8CC4AC76AA56D1.chapter_subtitle: [
		"Стіни, дах і щоб гостям не соромно."
	]
	chapter.5E8CC4AC76AA56D1.title: "Своя хата"
	chapter.6B99F12AA8D2B62E.chapter_subtitle: [
		"Найбільш замінована країна світу. Тут теж."
	]
	chapter.6B99F12AA8D2B62E.title: "Розмінування"
	chapter.7A625FD7D3C5B637.chapter_subtitle: [
		"Мирне життя, бо воно теж важливе."
	]
	chapter.7A625FD7D3C5B637.title: "Хата скраю з пивом"
	file.171C419DD6093313.title: "Світло Дали v0.5"
	quest.003A07DEA023CCFB.quest_desc: [
		"Графік відключень показує, що світло є. Поспішай, доки ДТЕК не передумав."
		""
		"Збери дерево і скрафти верстак."
	]
	quest.003A07DEA023CCFB.title: "Доброго ранку, ми з Майнкрафту"
	quest.0140E33BECA46C14.quest_desc: [
		"Смак як у Жигулівського з ларька біля дому, тільки без пластикової півторашки."
		""
		"Звари пиво в бочці."
	]
	quest.0140E33BECA46C14.title: "Жигулівське"
	quest.01ABD8BCFEBA82F1.quest_desc: [
		"На синьому вогні (суперперегрів) з двох бутлів браги виходить продукт преміум-класу."
		""
		"Запорізька класика. Козаки схвалюють."
	]
	quest.01ABD8BCFEBA82F1.title: "Хортиця"
	quest.02AB53E4E3B764E1.quest_desc: [
		"Кажуть, хтось колись приписав собі борщ. Відповідь — у каструлі."
		""
		"Скрафти каструлю (Cooking Pot)."
	]
	quest.02AB53E4E3B764E1.title: "Борщ або нічого"
	quest.039B8F21DC621440.quest_desc: [
		"Київ"
		""
		"Обережно, бризкає маслом. Як коментарі в київських пабліках."
	]
	quest.039B8F21DC621440.quest_subtitle: "Київ"
	quest.039B8F21DC621440.title: "Котлета по-київськи"
	quest.058E93A6D9A60594.quest_desc: [
		"Скриня вже вміє сортувати кнопкою. Фільтр додає, щоб у неї потрапляло лише потрібне."
	]
	quest.058E93A6D9A60594.title: "Сортувальний центр"
	quest.05BFE77763F96CFA.quest_desc: [
		"Час обзавестися власною ППО. Пасіка відкрита, мед не обіцяємо."
		""
		"Скрафти монітор керування дронами."
	]
	quest.05BFE77763F96CFA.title: "Відбій тривоги"
	quest.05CFCFF756B7BD8A.quest_desc: [
		"Своє борошно, без черги в АТБ."
	]
	quest.05CFCFF756B7BD8A.title: "Борошно"
	quest.06223F1C3DC5D263.quest_desc: [
		"Рейки, дерев'яні кріплення і павуки. Шахтарям — шана."
		""
		"Знайди покинуту шахту."
	]
	quest.06223F1C3DC5D263.title: "Шахта"
	quest.06C6E878DC6499C4.quest_desc: [
		"Перший освітлений двір у районі. Сусіди вже несуть подовжувачі, щоб зарядити телефони."
	]
	quest.06C6E878DC6499C4.title: "Двір під ліхтарями"
	quest.07E68ECED132F6B0.quest_desc: [
		"Металевий їжак — найкращий аргумент проти «Іржавого Т-72». Колючий, тому обіймати не раджу."
	]
	quest.07E68ECED132F6B0.title: "Їжаки на дорогах"
	quest.085C694AFC1CD0E1.quest_desc: [
		"Щоб було де поставити борщ."
		""
		"Скрафти будь-який стіл і будь-який стілець (Handcrafted або Another Furniture)."
	]
	quest.085C694AFC1CD0E1.title: "Стіл і стільці"
	quest.08E31D6F5A0E8484.quest_desc: [
		"Без них генератор — просто дуже дорога каруселька."
	]
	quest.08E31D6F5A0E8484.title: "Вугільні щітки"
	quest.099D0A877E036632.quest_desc: [
		"Полтавщина"
		""
		"Галушки самі в рот не стрибають. Це тобі не Гоголь."
	]
	quest.099D0A877E036632.quest_subtitle: "Полтавщина"
	quest.099D0A877E036632.title: "Полтавські галушки"
	quest.0A72FAB5D6C37F0E.quest_desc: [
		"Усе в Create крутиться. Обертання — це його «електрика»."
		""
		"Водяне колесо дає обертання, коли поруч тече вода (не стоїть!). Постав його так, щоб течія била в лопаті, і приєднай вал."
		"Для запоріжця будувати колеса — генетична пам'ять."
	]
	quest.0A72FAB5D6C37F0E.title: "ДніпроГЕС у мініатюрі"
	quest.0AB81AE0BA080C45.quest_desc: [
		"Капає тисячі років. Каска не завадить."
		""
		"Знайди печеру зі сталактитами."
	]
	quest.0AB81AE0BA080C45.title: "Сталактити"
	quest.0D97F52C79117AF0.quest_desc: [
		"Ньютон затвердив."
		""
		"Скрафти фізичний збирач (Physics Assembler) — з нього починається все, що рухається."
	]
	quest.0D97F52C79117AF0.title: "Перша фізика"
	quest.0EC2006C505BA439.quest_desc: [
		"Дванадцять страв на столі, як годиться. Сало не рахується, бо сало — святе."
		""
		"Збери по одній з дванадцяти страв цього розділу."
	]
	quest.0EC2006C505BA439.title: "Свят-вечір"
	quest.0FA0C5CFE59F2510.quest_desc: [
		"Степ, де пасуться зебри. Тут — коні й лами, але дух той самий."
		""
		"Знайди саванну."
	]
	quest.0FA0C5CFE59F2510.title: "Асканія-Нова"
	quest.0FAD39DE96BB3956.quest_desc: [
		"Покинуті села заміновані, а в полях трапляються мінні поля з колючкою й табличками."
		""
		"Правило №1: крадись (Shift). Клеймор не спрацює на того, хто йде навшпиньки."
		"Правило №2: «пелюстки» (BLU-43) лежать на землі й вибухають, якщо на них наступити. Дивись під ноги."
	]
	quest.0FAD39DE96BB3956.title: "Обережно, міни!"
	quest.0FD992256BBE0F8C.quest_desc: [
		"Хата готова. Клич друзів, накривай стіл, показуй стінку."
		""
		"Коли всі подивились і похвалили — тисни галочку. Банк дарує 2000 ₴ на облаштування."
	]
	quest.0FD992256BBE0F8C.title: "Новосілля"
	quest.11F784772C8D0DCC.quest_desc: [
		"Щука, сом, короп і судак. Класика будь-якого рибалки з Хортиці."
	]
	quest.11F784772C8D0DCC.title: "Дніпро"
	quest.13025E9167C3282C.quest_desc: [
		"Без коментарів. Просто влучно."
		""
		"Влуч дроном у будь-яку ціль і натисни галочку."
	]
	quest.13025E9167C3282C.title: "Влучно"
	quest.13CBA60B47A4DB65.quest_desc: [
		"Знешкоджувач SBW. Підкрадись до міни й використай його на ній. Повільно."
	]
	quest.13CBA60B47A4DB65.title: "Сапер помиляється один раз"
	quest.13D5F0F3558A9AAD.quest_desc: [
		"Візитівка країни. Жовте з блакитним."
		""
		"Знайди соняшникові рівнини."
	]
	quest.13D5F0F3558A9AAD.title: "Соняшникове поле"
	quest.161B982AB8ED4BCA.quest_desc: [
		"Протягни лінію між стовпами. Як енергетики після прильоту: швидко, вночі і без вихідних."
	]
	quest.161B982AB8ED4BCA.title: "Дроти"
	quest.173102F75D4E098C.quest_desc: [
		"Чеська стінка з кришталем, який дістають раз на рік."
		""
		"Шафа, комод або полиця."
	]
	quest.173102F75D4E098C.title: "Стінка"
	quest.180505CAEFC083C1.quest_desc: [
		"Сирена й сітка проти чужих трутнів. Хто перший сказав «ППО на даху», той і молодець."
	]
	quest.180505CAEFC083C1.title: "Своя ППО"
	quest.18DF954618D1CD6A.quest_desc: [
		"Записуєш кожну рибу, як справжній рибак — тільки без перебільшень про розмір."
	]
	quest.18DF954618D1CD6A.title: "Журнал риболова"
	quest.1A416F9108535100.quest_desc: [
		"Найдавніші хліборобські поселення на наших землях. Візьми щітку — археологія чекає."
		""
		"Знайди стежкові руїни."
	]
	quest.1A416F9108535100.title: "Трипілля"
	quest.1B47D2446D241195.quest_desc: [
		"Найкращий підручник у світі. Без ЗНО."
		""
		"Наведи курсор на будь-який блок Create у JEI чи в інвентарі, затисни W і подивись анімацію. Потім натисни галочку."
	]
	quest.1B47D2446D241195.title: "Затисни W"
	quest.1BE58896553780F3.quest_desc: [
		"Щоб потяги не зустрічалися, як дві маршрутки на одній зупинці."
	]
	quest.1BE58896553780F3.title: "Стрілочник"
	quest.1CD5C25D251D9EDA.quest_desc: [
		"Create без водяного колеса. Дід з ДніпроГЕСу не схвалив би, але й не заперечив би."
	]
	quest.1CD5C25D251D9EDA.title: "Електромотор"
	quest.1D07EBE8303F0870.quest_desc: [
		"Пішов туди, куди його послали. Тепер тут риба і скарби."
		""
		"Знайди затонулий корабель."
	]
	quest.1D07EBE8303F0870.title: "Крейсер на дні"
	quest.1DBB4219EB020DB4.quest_desc: [
		"Чорне море"
		""
		"Пиво є? Хамса є. Привоз схвалює."
	]
	quest.1DBB4219EB020DB4.quest_subtitle: "Чорне море"
	quest.1DBB4219EB020DB4.title: "Бутерброд з хамсою"
	quest.20DEFAF3E6846E07.quest_desc: [
		"Розміновуй мінне поле до останньої пелюстки й поверни землю фермерам."
		""
		"Коли закінчиш — тисни галочку."
	]
	quest.20DEFAF3E6846E07.title: "Поле чисте"
	quest.226CCE7FDDE65642.quest_desc: [
		"Для залізних листів. Не плутати з пресою, яка про все пише першою."
		""
		"Прес над депо або конвеєром плющить злитки в листи. Над басейном — пресує й ущільнює."
	]
	quest.226CCE7FDDE65642.title: "Прес"
	quest.23141ED841BA19B5.quest_desc: [
		"У кожного запорізького діда в гаражі є сталь. Звідки — краще не питати."
		""
		"Виплав сталевий злиток."
	]
	quest.23141ED841BA19B5.title: "Гаражний метал"
	quest.23AF8F722D921422.quest_desc: [
		"Так, в Україні є пустеля. Тепер ти її бачив."
		""
		"Знайди пустелю."
	]
	quest.23AF8F722D921422.title: "Олешківські піски"
	quest.25481107EC63633C.quest_desc: [
		"Тепер мінуєш ти. Тільки табличку «Міни» поставити не забудь."
	]
	quest.25481107EC63633C.title: "Своє мінне поле"
	quest.273016BA89606DBE.quest_desc: [
		"Одна з найдовших печер світу — під Тернопільщиною. Тут — зелена й квітуча."
		""
		"Знайди пишну печеру."
	]
	quest.273016BA89606DBE.title: "Печера Оптимістична"
	quest.299B2B5CA321D78F.quest_desc: [
		"Та сама мідь, яку з-за поребрика так полюбляють виносити з підстанцій. Тут вона під охороною."
	]
	quest.299B2B5CA321D78F.title: "Мідна котушка"
	quest.2CADEDC7368A1A56.quest_desc: [
		"Аеропорт Запоріжжя закритий. Твій — працює."
		""
		"Постав камінь телепортації на борту корабля і натисни галочку."
	]
	quest.2CADEDC7368A1A56.title: "Повітряний вокзал"
	quest.2D5001A0C8CB49F9.quest_desc: [
		"Не готель, зате свій. І фантоми не прилетять."
		""
		"Переночуй у спальнику з Comforts."
	]
	quest.2D5001A0C8CB49F9.title: "Комфорт у бліндажі"
	quest.2E65061DB4494E06.quest_desc: [
		"Найкращі два слова цієї зими."
		""
		"Постав ліхтарний стовп і запали його від свого генератора."
	]
	quest.2E65061DB4494E06.title: "Світло дали!"
	quest.2EA47E207DE37896.quest_desc: [
		"Кожен механізм «їсть» трохи сили (навантаження, SU). Джерело дає обмежено."
		""
		"Якщо механізмів більше, ніж джерело тягне, — уся лінія зупиняється. Як мережа, коли всі разом увімкнули чайники."
		"Спідометр показує оберти, стресометр — скільки сили лишилось."
	]
	quest.2EA47E207DE37896.title: "Навантаження"
	quest.2FB18E48658803DD.quest_desc: [
		"Цукор, картопля, пшениця — і бочка. Дід казав, що головне — терпіння. І щоб баба не знайшла."
	]
	quest.2FB18E48658803DD.title: "Брага"
	quest.3124E0F6C3E680AA.quest_desc: [
		"Магніт є в кожного на холодильнику. У тебе буде на генераторі."
		""
		"Зроби блок магнетиту — з нього починається вся електрика."
	]
	quest.3124E0F6C3E680AA.title: "Магніт"
	quest.349D31AB6072BE4E.quest_desc: [
		"Тепер видно все, крім сенсу спати вночі."
	]
	quest.349D31AB6072BE4E.title: "Окуляри"
	quest.35107AD64A34DC11.quest_desc: [
		"Волинь"
		""
		"Поки охолонуть, родичі вже все з'їдять."
	]
	quest.35107AD64A34DC11.quest_subtitle: "Волинь"
	quest.35107AD64A34DC11.title: "Голубці"
	quest.355FA50BAE5EDE31.quest_desc: [
		"Поділля"
		""
		"Пузатий Пацюк закидав їх у рот силою думки. Тобі доведеться виделкою."
	]
	quest.355FA50BAE5EDE31.quest_subtitle: "Поділля"
	quest.355FA50BAE5EDE31.title: "Вареники"
	quest.35C62E01C245DC20.quest_desc: [
		"Тут знайдеш жителів у вишиванках і, можливо, відділення Нової Пошти."
		""
		"Знайди село."
	]
	quest.35C62E01C245DC20.title: "Своє село"
	quest.35FDAA92E670B5AF.quest_desc: [
		"Хліб усьому голова. А ще найкращий тест: якщо гість не може це вимовити — у СБУ до нього питання."
		""
		"Випечи паляницю з тіста в печі або коптильні."
	]
	quest.35FDAA92E670B5AF.title: "Скажи «паляниця»"
	quest.36C8C08B77D43243.quest_desc: [
		"Знятий з дверей покинутої хати. Тепер він твій. Напис «Front toward enemy» читай уважно."
	]
	quest.36C8C08B77D43243.title: "Трофейний клеймор"
	quest.37332CF5ABFBA93D.quest_desc: [
		"Гаряче повітря піднімається вгору. Перевірено на кожній сварці в чаті будинку."
	]
	quest.37332CF5ABFBA93D.title: "Повітряна куля"
	quest.398CDC3D4190A6E0.quest_desc: [
		"Мрія повертається. Поки що в кубах."
		""
		"Підніми в повітря свій перший літальний апарат і натисни галочку."
	]
	quest.398CDC3D4190A6E0.title: "Мрія 2"
	quest.39FEFB1CE80E2F95.title: "Пелюстка під ногами"
	quest.3AF984D9F778E52A.title: "Мінне поле"
	quest.3B0D7674E1118F98.quest_desc: [
		"Запоріжсталь передає привіт. Димить менше, зате твоє."
		""
		"Назбирай 64 залізні злитки."
	]
	quest.3B0D7674E1118F98.title: "Металург"
	quest.3C2B4995EC695B2A.quest_desc: [
		"Жнива без мозолів."
		""
		"Жатку (harvester) і плуг став на рухомий механізм: поршень, підшипник або вагонетку зі збирачем."
		"Механізм їде по полю і збирає врожай сам, а насіння залишає в землі."
	]
	quest.3C2B4995EC695B2A.title: "Комбайн"
	quest.3C6F3E1A226CD09B.quest_desc: [
		"Риба з Дніпра біля Хортиці. Козаки ловили тут задовго до тебе, і без мінігри."
		""
		"Злови першу рибу вудкою Tide. Коли клює — тримай поплавок у зеленій зоні."
	]
	quest.3C6F3E1A226CD09B.title: "Риболов"
	quest.3C757E759D0E8DF1.quest_desc: [
		"Саморобний дробовик. У гаражі в кожного діда знайдеться щось цікаве — ти просто перший, хто туди заглянув."
	]
	quest.3C757E759D0E8DF1.title: "Ствол"
	quest.3CCCDCB4352422F1.quest_desc: [
		"Вежа мародерів. Обережно: стріляють з арбалетів."
		""
		"Знайди аванпост мародерів."
	]
	quest.3CCCDCB4352422F1.title: "Блокпост окупантів"
	quest.3D1F8B9FB82D91A2.quest_desc: [
		"Мелемо зерно, а не язиком."
		""
		"Жорна (millstone) крутяться від вала зверху або збоку. Кидай пшеницю — отримуєш борошно."
		"Ще мелють квіти на барвники, гравій на кремінь і кістки на кістяне борошно."
	]
	quest.3D1F8B9FB82D91A2.title: "Млин"
	quest.3EA2D135108CAD3D.quest_desc: [
		"Серце хати. Тут вирішуються всі сімейні питання."
		""
		"Кухонна стільниця або духовка з Handcrafted."
	]
	quest.3EA2D135108CAD3D.title: "Кухня"
	quest.3F3B7B2B76470919.quest_desc: [
		"Змішувач над басейном мішає все, що в нього кинули. Під басейном вогонь — гаряче змішування."
		""
		"Так роблять тісто, латунь, шоколад і багато чого ще."
	]
	quest.3F3B7B2B76470919.title: "Змішувач"
	quest.400F9982FF9A47DE.quest_desc: [
		"Як у дитинстві, тільки без бабусь з розсадою в тамбурі."
		""
		"Протягни контактну мережу над колією і постав на потяг пантограф."
	]
	quest.400F9982FF9A47DE.title: "Електричка Запоріжжя — Дніпро"
	quest.40B9D7ABEA8ED776.quest_desc: [
		"Одеса"
		""
		"В Одесі скажуть, що в мами були кращі. І матимуть рацію."
	]
	quest.40B9D7ABEA8ED776.quest_subtitle: "Одеса"
	quest.40B9D7ABEA8ED776.title: "Сирники"
	quest.42218062ED36CC15.quest_desc: [
		"Лампа, фіранки, подушка, картина — щось, що робить коробку домом."
	]
	quest.42218062ED36CC15.title: "Затишок"
	quest.42FFE8BAAFD1749A.quest_desc: [
		"Ширина колії 1520. Не перевіряли, але віримо."
		""
		"Покладіть 64 рейки Create."
	]
	quest.42FFE8BAAFD1749A.title: "Колія"
	quest.432C5FB70CAB0E07.quest_desc: [
		"Затримка потяга: 0 хвилин. Ти вже кращий за реальність."
		""
		"Скрафти розклад і запусти потяг за ним."
	]
	quest.432C5FB70CAB0E07.title: "Розклад"
	quest.437C463D67416606.quest_desc: [
		"Тривога триває всю ніч, а ти досі спиш на другому поверсі?"
		""
		"Переночуй у ліжку глибоко під землею, нижче Y=30."
	]
	quest.437C463D67416606.title: "Укриття"
	quest.440F8FE4A51E3D28.quest_desc: [
		"Борошно + вода. На верстаті з відром води, або автоматично в змішувачі."
		""
		"З тіста в печі виходить паляниця. Пароль перевірено."
	]
	quest.440F8FE4A51E3D28.title: "Тісто"
	quest.45DD614B7FF00FC7.quest_desc: [
		"Оце вже серйозно. Козаки були б у захваті."
		""
		"Збери міномет."
	]
	quest.45DD614B7FF00FC7.title: "Важка артилерія"
	quest.461501CCC066B81F.quest_desc: [
		"Найнадійніше укриття: ковдра на голову. Перевірено мільйонами."
		""
		"Переночуй у ліжку. І не забувай спати й надалі, бо інакше прилетить щось неприємне."
	]
	quest.461501CCC066B81F.title: "Ліжко як укриття"
	quest.464189C5C1ACA919.quest_desc: [
		"Кожен запорожець десь має прадіда-козака. Навіть якщо прадід з Мелітополя."
	]
	quest.464189C5C1ACA919.title: "Дідів ніж"
	quest.4740C195A62FE719.quest_desc: [
		"Полтавщина"
		""
		"Той самий борщ, який хтось намагався приписати собі. ЮНЕСКО вже розсудило."
	]
	quest.4740C195A62FE719.quest_subtitle: "Полтавщина"
	quest.4740C195A62FE719.title: "Борщ"
	quest.4759F88487F0054D.quest_desc: [
		"Патрульна поліція смарагди приймає, але неохоче. Банкомат міняє смарагд на 400 ₴ і видає готівку."
		""
		"ПКМ зі смарагдами чи купюрами в руці — покласти. Порожньою рукою — зняти 500 ₴. Shift+ПКМ — баланс."
		"Штраф спершу списується з картки, потім з кишені. Решти патрульні не дають."
	]
	quest.4759F88487F0054D.title: "Банкомат біля відділення"
	quest.4784731FA8714632.quest_desc: [
		"Steam 'n' Rails додає ретро-сигналізацію. Майже як на станції Запоріжжя-Ліве у 80-х."
	]
	quest.4784731FA8714632.title: "Семафор"
	quest.47E512BDFE61B45E.quest_desc: [
		"Тепер ти сам собі Нова Пошта, тільки без черг і без SMS о сьомій ранку."
	]
	quest.47E512BDFE61B45E.title: "Пакувальник"
	quest.4811A3713BCE488E.quest_desc: [
		"Як повітряний змій, тільки серйозніший. Ніякі глушилки не страшні."
	]
	quest.4811A3713BCE488E.title: "На ниточці"
	quest.4A28C7FD80369994.quest_desc: [
		"Тепер графік відключень пишеш ти. Можеш поставити собі світло цілодобово, ніхто не заборонить."
		""
		"Збери генератор: магніти, котушки, щітки й обертання від Create. Коли запрацює — тисни галочку."
	]
	quest.4A28C7FD80369994.title: "Свій ДТЕК"
	quest.4AD90B9A1F9CD82C.quest_desc: [
		"Єдиний трутень, який реально працює."
	]
	quest.4AD90B9A1F9CD82C.title: "Перший трутень"
	quest.4C665E18B1CA3D27.quest_desc: [
		"Дві дробильні колеса, що крутяться назустріч одне одному, перетирають руду."
		""
		"З однієї руди — подрібнена руда і бонус. Промий вентилятором крізь воду й переплав: металу виходить помітно більше."
	]
	quest.4C665E18B1CA3D27.title: "Дробарка"
	quest.4D00A153C105F674.quest_desc: [
		"Форель із гірської річки. Підходить до бограча і до чаю з полониною."
	]
	quest.4D00A153C105F674.title: "Карпати"
	quest.4DD465DCD5892244.quest_desc: [
		"Енергайзер заряджає речі. Обов'язкова підготовка до зими, як закрутки в бабусі."
	]
	quest.4DD465DCD5892244.title: "Павербанк на зиму"
	quest.4E08DA6B17A4DE0F.quest_desc: [
		"Крафтове пиво. Хіпстерський бар у Львові вже нервує."
	]
	quest.4E08DA6B17A4DE0F.title: "Бочка"
	quest.4ECAA774743BD2B6.quest_desc: [
		"Вся Україна"
		""
		"Ріж на дошці ножем. Сало — не їжа, а стан душі."
	]
	quest.4ECAA774743BD2B6.quest_subtitle: "Вся Україна"
	quest.4ECAA774743BD2B6.title: "Сало"
	quest.51610BE7705348E4.quest_desc: [
		"Чи рідкий птах долетить до середини? Перевір."
		""
		"Дійди до річки."
	]
	quest.51610BE7705348E4.title: "Дніпро"
	quest.531FC9959F7BC030.quest_desc: [
		"Як на хуторі під Полтавою, тільки крутить конвеєр, а не жорна."
		""
		"Підшипник вітряка + вітрила навколо (мінімум 8 блоків вітрил). ПКМ по підшипнику — і він закрутиться."
		"Чим більше вітрил, тим більше сили. Вітру байдуже на графіки відключень."
	]
	quest.531FC9959F7BC030.title: "Вітряк"
	quest.54E9A6620E96E31A.quest_desc: [
		"Як роздатка в УАЗі, тільки не ламається."
		""
		"Коробка передач повертає обертання на 90° у всі боки. Реверс (gearshift) міняє напрям, коли на нього подати редстоун."
		"Зчеплення (clutch) вимикає вал від сигналу — твій власний рубильник."
	]
	quest.54E9A6620E96E31A.title: "Коробка передач"
	quest.5701A078ABD73D4F.quest_desc: [
		"Свят-вечір"
		""
		"Без узвару кутя не та. Пий і дивись на першу зірку."
	]
	quest.5701A078ABD73D4F.quest_subtitle: "Свят-вечір"
	quest.5701A078ABD73D4F.title: "Узвар"
	quest.58578FE666023D9D.title: "Клеймор у хаті"
	quest.58CCA6AAFDA97C2E.quest_desc: [
		"Змішувач Create над запаленою топкою ифрита (blaze burner) жене брагу в самогон."
		"Сила й захист, але голова крутиться. Три чарки за вечір — і зранку похмілля."
	]
	quest.58CCA6AAFDA97C2E.title: "Самогонний апарат"
	quest.58DADF35D7CC6753.quest_desc: [
		"Три ночі без сну, і над головою вже щось дзижчить. Знайома історія."
	]
	quest.58DADF35D7CC6753.title: "Повітряна тривога"
	quest.5B81CDB348F32F1E.quest_desc: [
		"Матеріал подвійного призначення: сьогодні шестерні, завтра гільзи. Запам'ятай цей квест."
		""
		"Мідь + цинк у змішувачі над запаленою топкою. Виплав 16 латунних злитків."
	]
	quest.5B81CDB348F32F1E.title: "Латунь"
	quest.5BB32F8B9349599F.quest_desc: [
		"Той, що стоїть за склом і чекає на свято."
		""
		"Тарілка або чашка з Handcrafted."
	]
	quest.5BB32F8B9349599F.title: "Сервіз для гостей"
	quest.5CBD6041CEF5C416.quest_desc: [
		"Хамса, скумбрія і камбала. Одеса передає привіт і просить не торгуватися."
	]
	quest.5CBD6041CEF5C416.title: "Чорне море"
	quest.5D15BC7BBDB991EB.quest_desc: [
		"Головка сиру дозріває довго. Як і зарплата."
	]
	quest.5D15BC7BBDB991EB.title: "Сир"
	quest.5E8DBF7F1D0BE712.quest_desc: [
		"Гуцульщина"
		""
		"Мішати однією рукою, бо в другій має бути трембіта."
	]
	quest.5E8DBF7F1D0BE712.quest_subtitle: "Гуцульщина"
	quest.5E8DBF7F1D0BE712.title: "Банош"
	quest.5F5987F88DC2E14F.quest_desc: [
		"Землянка — це етап, а не спосіб життя."
		""
		"Збудуй хату: стіни, дах, двері, вікна і ліжко. Переночуй у ній і тисни галочку."
	]
	quest.5F5987F88DC2E14F.title: "Хата, де твій край"
	quest.5FC4DA0F27F3414F.quest_desc: [
		"Запоріжжя-1 чекає на перший рейс."
	]
	quest.5FC4DA0F27F3414F.title: "Вокзал"
	quest.6043D250571D43A8.quest_desc: [
		"Запоріжжя"
		""
		"Козацька юшка на вогнищі. Їсти після рибалки, до неї і замість неї."
	]
	quest.6043D250571D43A8.quest_subtitle: "Запоріжжя"
	quest.6043D250571D43A8.title: "Юшка з Хортиці"
	quest.60F8D8B626EE45B2.quest_desc: [
		"Гори, полонини і бринза. Говерла чекає."
		""
		"Дійди до гір."
	]
	quest.60F8D8B626EE45B2.title: "Карпати"
	quest.61C40E8E62235D41.quest_desc: [
		"Огірки, три штуки, плюс сушена ламінарія замість солі — у бочку. З'їв огірки — розсіл лишився."
		"Розсіл знімає похмілля. Насіння огірків — з трави або в бабусі на базарі."
	]
	quest.61C40E8E62235D41.title: "Ранок після"
	quest.64551C4918DB9FF6.quest_desc: [
		"Болота, ліси й деруни. Тут картоплю шанують."
		""
		"Знайди болото."
	]
	quest.64551C4918DB9FF6.title: "Полісся"
	quest.64D8CF7B0509C7E2.quest_desc: [
		"Помідори на балконі — українська національна агротехнологія."
		""
		"Ящик для квітів з Another Furniture."
	]
	quest.64D8CF7B0509C7E2.title: "Балкон з розсадою"
	quest.656E072A03B25DD5.quest_desc: [
		"Ока Ендера ведуть сюди. Далі — Двоголова курка."
		""
		"Знайди фортецю (stronghold)."
	]
	quest.656E072A03B25DD5.title: "Підземна фортеця"
	quest.66D1BF405EA26A59.quest_desc: [
		"Мисливець з тебе так собі, але трофей висить гордо."
		""
		"Будь-який трофей з Handcrafted."
	]
	quest.66D1BF405EA26A59.title: "Трофей на стіну"
	quest.67750AAE478F3036.quest_desc: [
		"Рюкзак, компас і термос. Решту знайдеш дорогою."
		""
		"Скрафти компас."
	]
	quest.67750AAE478F3036.title: "У дорогу"
	quest.6C8DFD6B138A2763.quest_desc: [
		"Полісся"
		""
		"На Поліссі картоплю не просто їдять. Її шанують."
	]
	quest.6C8DFD6B138A2763.quest_subtitle: "Полісся"
	quest.6C8DFD6B138A2763.title: "Деруни"
	quest.6D0701A4F84C7EAD.quest_desc: [
		"Приблизно через добу після того, як ти взяв зброю, противник підтягує штурмові групи з автоматами."
		"Вони приходять уночі загонами по троє. Окопайся, постав їжаків і тримай набої під рукою."
		""
		"Знищ 5 окупантів-штурмовиків."
	]
	quest.6D0701A4F84C7EAD.title: "Штурмовики"
	quest.6E5B815FD96C9D47.quest_desc: [
		"Дія вже вміє все, крім телепортів. Виправляємо."
		""
		"Скрафти або знайди в селі камінь телепортації (Waystone)."
	]
	quest.6E5B815FD96C9D47.title: "Дія.Телепорт"
	quest.6E637ED44335207A.quest_desc: [
		"Осетер! Сфотографуй і відпусти. Ну, або хоча б покажи друзям перед тим, як відпустити."
	]
	quest.6E637ED44335207A.title: "Червона книга"
	quest.6E8E1F8CC10A5FC6.quest_desc: [
		"Двигун Стірлінга: свій маленький генератор у дворі. Поребрик може скільки завгодно цілитися по ТЕС."
	]
	quest.6E8E1F8CC10A5FC6.title: "Енергоострів"
	quest.6EF5AD2B8EE0F07C.quest_desc: [
		"Збери повну лінію: млин → борошно → змішувач з водою → тісто на конвеєрі → вентилятор крізь вогонь → паляниці в скриню."
		""
		"Коли перша паляниця сама доїде до скрині — тисни галочку. Київхліб нервує."
	]
	quest.6EF5AD2B8EE0F07C.title: "Хлібозавод «Світло Дали»"
	quest.6FCBF43A4CFCE55B.quest_desc: [
		"Без ножа не наріжеш ні сала, ні ковбаски."
		""
		"Скрафти кремінний ніж з Farmer's Delight."
	]
	quest.6FCBF43A4CFCE55B.title: "Кухонний ніж"
	quest.71A05B05CCB713BD.quest_desc: [
		"Фундамент усієї механіки Create. Як сало для української кухні."
		""
		"Андезит + залізний самородок (або цинк) на верстаті. Із нього роблять вали, шестерні й корпуси."
		"Головна підказка всієї збірки: наведи курсор на предмет Create і затисни W — гра покаже анімацію, як він працює."
	]
	quest.71A05B05CCB713BD.title: "Андезитовий сплав"
	quest.71A13E20D5210F60.quest_desc: [
		"Пляж, хамса і кукурудза з сіллю."
		""
		"Вийди до морського пляжу."
	]
	quest.71A13E20D5210F60.title: "Чорне море"
	quest.7375D9A70BB16BAB.quest_desc: [
		"Як на Новій Пошті, тільки нічого не губиться."
		""
		"Візьми конвеєрну стрічку і ПКМ по двох валах на одній лінії — між ними натягнеться конвеєр. Він везе предмети і мобів."
		"Лійка (funnel) кладе або забирає зі скринь, депо — тримає предмет для обробки."
	]
	quest.7375D9A70BB16BAB.title: "Конвеєр"
	quest.73CC47542E77624C.quest_desc: [
		"Вал передає обертання прямо. Шестерні — вбік, якщо стоять зубцями одна до одної."
		""
		"Маленька шестерня, що крутить велику, — повільніше, але сильніше. Велика, що крутить маленьку, — у 2 рази швидше."
		"Так у Create міняють швидкість: кожен механізм любить свої оберти."
	]
	quest.73CC47542E77624C.title: "Шестерні й вали"
	quest.75AD9BC6C23618F8.quest_desc: [
		"Краще в рюкзаку, ніж під ногою."
	]
	quest.75AD9BC6C23618F8.title: "Пелюстки"
	quest.767DB44622EE8C48.quest_desc: [
		"Без них Create — як ДТЕК без лічильника."
		""
		"Вдягни окуляри й дивись на механізми: побачиш швидкість обертання і скільки навантаження з'їдає кожен блок."
	]
	quest.767DB44622EE8C48.title: "Окуляри інженера"
	quest.76EA33FB81E37BE5.quest_desc: [
		"Посилка надійде за 1 день. Або за 3. Залежить від шахедів."
		""
		"Скрафти розумну скриню Sophisticated Storage."
	]
	quest.76EA33FB81E37BE5.title: "Відділення №1"
	quest.776A6BC35ADB5AC8.quest_desc: [
		"Ось і подвійне призначення."
		""
		"Набої тепер збираються лише на конвеєрі Create: латунний лист, метал, порох, капсуль і прес. Увесь ВПК в одному гаражі."
	]
	quest.776A6BC35ADB5AC8.title: "Набій"
	quest.77DBAADFDF234C46.quest_desc: [
		"Обираєш на екрані, що треба, і склад сам усе збирає. Мрія кожного, хто стояв у черзі на відділенні."
	]
	quest.77DBAADFDF234C46.title: "Поштомат"
	quest.79564354ED61509A.quest_desc: [
		"Помідори і капуста. Бабуся б схвалила, але сказала б, що замало."
	]
	quest.79564354ED61509A.title: "Город"
	quest.7AD987A1B64D664E.quest_desc: [
		"Сніг, лижі і глінтвейн. Без лиж теж можна."
		""
		"Знайди засніжені схили."
	]
	quest.7AD987A1B64D664E.title: "Драгобрат"
	quest.7B48CEA7BEEBFBA2.quest_desc: [
		"З покривалом, щоб не протерти."
		""
		"Будь-який диван чи софа."
	]
	quest.7B48CEA7BEEBFBA2.title: "Диван як у бабусі"
	quest.7C2696F286C59D27.quest_desc: [
		"Енергетики: цукор, вода, щось ще і бляшанка (самородок під пресом Create). Змішуються в змішувачі."
		"Non Stop — бігати, Monster — копати, Ultra — бачити вночі, Red Bull — окриляє."
		"Коли дія мине — відходняк. Три банки за день — серце калатає."
	]
	quest.7C2696F286C59D27.title: "Нічна зміна"
	quest.7D0C35F70A79D91F.quest_desc: [
		"Вентилятор дує крізь те, що стоїть перед ним, і обробляє предмети на льоту:"
		""
		"крізь вогонь або багаття — пече й коптить їжу; крізь воду — промиває; крізь лаву — плавить."
		"Пускай повз нього конвеєр із тістом — отримаєш хлібозавод."
	]
	quest.7D0C35F70A79D91F.title: "Вентилятор-піч"
	quest.7E775B3910731B41.quest_desc: [
		"Тиша, темрява і щось, що чує кожен твій крок. Краще навшпиньки."
		""
		"Знайди стародавнє місто глибоко під землею."
	]
	quest.7E775B3910731B41.title: "Одеські катакомби"
	quest.7EE60CFC532F1C9F.quest_desc: [
		"Крутиться — значить, летить. Ну, майже."
	]
	quest.7EE60CFC532F1C9F.title: "Пропелер"
	quest.7F433740F91AADE4.quest_desc: [
		"Кур'єр на самокаті вже не потрібен. Жаба доставить сама."
	]
	quest.7F433740F91AADE4.title: "Кур'єр-жаба"
	quest.7FD6B696CB86A1E0.quest_desc: [
		"ЗАЗ так і не випустив потяг. Виправляємо історичну несправедливість."
		""
		"Скрафти пульт керування потягом і збери свій перший состав."
	]
	quest.7FD6B696CB86A1E0.title: "Запорожець на рейках"
	quest.7FE4BF362CE15C84.quest_desc: [
		"Найкращий сапер країни — пес. Приручи собі помічника."
		""
		"Приручений пес чує міни за 8 блоків: сідає, гарчить, а міна починає світитися крізь траву й стіни."
		"Далі — Shift і знешкоджувач. І пса з собою на мінне поле краще не пускати: він теж живий."
	]
	quest.7FE4BF362CE15C84.title: "Помічник сапера"
}
